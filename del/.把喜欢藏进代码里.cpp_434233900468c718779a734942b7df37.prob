{"name":"把喜欢藏进代码里","group":"NowCoder","url":"https://ac.nowcoder.com/acm/contest/121806/C","interactive":false,"memoryLimit":512,"timeLimit":2000,"tests":[{"input":"Patricky.c\n6\n#include <stdio.h>\nint main() { // I cares none but you tonight.\n  puts(\"qwq please dont condemn me for this problem.\");\n  puts(\"If you've passed all problems except this, congrats! But I trust you could pass this one easily!\");\n  return 0 ^ 0; /* 0 ^ 0 => 0 xor 0 equals 0 just like my eternal love to him.*/\n}\n","output":"#2: \" I cares none but you tonight.\"\n#5: \" 0 ^ 0 => 0 xor 0 equals 0 just like my eternal love to him.\"\n","id":1762671663599},{"input":"checker.py\n17\nimport os\n\n# ananana\n\ncmd = 'python -c \"'\nwhile True:\n    try:\n        s = input()\n        cmd += s + (';\\n' if s != '' else '')\n    except EOFError: break\n\ncmd += '\"'\n\nif os.system(cmd) != 0 or os.popen(cmd).read().splitlines()[0][:7] != '1314520':\n    print('WA')\nelse:\n    print('AC')\n","output":"#3: \" ananana\"\n","id":1762671663600},{"id":1762671663601,"input":"patricky_loves_you.php\n11\n<?php\n# Love all, trust a few, do wrong to none.\n\nfunction call() {\n\treturn \"anything\";\n} //it\"\n\ntrue /* I love you! */ && /* I love you! */ true;\n\nvar_dump(call());\n?>\n","output":"#2: \" Love all, trust a few, do wrong to none.\"\n#6: \"it\\\"\"\n#8: \" I love you! \"\n#8: \" I love you! \"\n"},{"id":1762680520234,"input":"patricky_loves_you.c\n11\n<?php\n# Love all, trust a few, do wrong to none.\n\nfunction call() {\n\treturn \"anything\";\n} // \"it\" \"\n\ntrue /* I love you! */ && /* I love you! */ true;\n\nvar_dump(call());\n?>\n","output":""},{"id":1762681227388,"input":"111.py\n1\n\"\"\" asd\"lkj\"aslkdjasd \"\"\"\"\"","output":""},{"id":1762681477717,"input":"Patricky.c\n6\n#include <stdio.h>\nint main() { // I cares none but you tonight.\n  puts(\"qwq please dont condemn me for this problem.\");\n  puts(\"If you've passed all problems except this, congrats! But I trust you could pass this one easily!\");\n  return 0 ^ 0; /* 0 ^ 0 => 0 xor 0 equals 0 just like my eternal love to him.*/\n}// 123\n","output":""},{"id":1762687469410,"input":"patricky_loves_you.py\n11\n<?php\n# Love all, trust a few, do wrong to none.\n\nfunction call() {\n\treturn \"anything\";\n} // \"it\" \"\n\ntrue \"\"\" I love you! \"\"\" && \"\"\" I love you! \"\"\" true;\n\nvar_dump(call());\n?>\n","output":""},{"id":1762692583789,"input":"1.html\n1\nasd <!-- asdasdqwe --><!-- asdasdqwe -->","output":""},{"id":1762694367229,"input":"1.c\n8\n#include <iostream>\nusing namespace std;\n\nint main() {\n  string s = \"//这是一个字符串内的注释符号\";\n  // 这是一个真正的注释\n  return 0;\n}","output":""},{"id":1762694433013,"input":"test.py\n1\n\"\"\"This is a string\"\"\" # comment","output":""},{"id":1762696149645,"input":"test.c\n1\n// comment /* not a real block comment */","output":""}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"Task"}},"batch":{"id":"616ca15b-b012-481d-b416-d0ff08f6f39b","size":1},"srcPath":"/Users/v/ACM/Contests/XX/第八届传智杯程序设计赛道模拟考（第二场）/把喜欢藏进代码里.cpp"}